# Large / regenerable activation dumps (~150MB+ of .npy, over GitHub's 100MB
# per-file limit). Regenerate with: python probe.py --stage extract
probe_output/activations/
**/probe_output/activations/
match_*/**/*.npy

# Generated clock images -- regenerable from clocks.py, not source data.
#   data/            -> python clocks.py --n 500 --seed 42
#   data_balanced/    -> python clocks.py --balanced --out_dir data_balanced
#   data_positions/   -> python balanced_clocks.py
data/
data_balanced/
data_positions/

# Archives (Kaggle download bundles etc.)
*.zip

# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
.venv/
env/

# Secrets / local config
.env

# Editor / OS cruft
.ipynb_checkpoints/
.DS_Store

# Claude Code session metadata (local, not project content)
.claude/

conversion_images/

# Experiment R: real photos are evaluation-only, NEVER redistributed (PREREG_MECHANISM.md ninth entry); styled sets are regenerable (make_styled_set.py)
data_photos*/
**/data_photos*/
data_s1_thin/
data_s2_ticks/
